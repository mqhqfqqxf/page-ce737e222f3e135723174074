: 6px}\n  .client .platform {font-size: 12px;letter-spacing: .14em;text-transform: uppercase;color: var(--cyan-deep);font-weight: 700;margin-bottom: 12px}\n  .client p {font-size: 14px;color: var(--slate-700);margin: 0 0 14px}\n  .client .link {font-size: 14px;font-weight: 600;border-bottom: 1px solid var(--cyan-soft);padding-bottom: 1px}\n  .client .link.muted {color: var(--slate-500);border-bottom-color: var(--slate-100);font-weight: 500}\n\n  /* ===== FAQ 编号列表 ===== */\n  .faq-block {background: #fff;border-radius: var(--radius);box-shadow: var(--shadow);padding: 8px 32px 12px}\n  .faq-item {display: grid;grid-template-columns: 64px 1fr;gap: 20px;padding: 26px 0;border-top: 1px solid var(--slate-100)}\n  .faq-item:first-child {border-top: 0}\n  .faq-num {font-size: 26px;font-weight: 800;color: var(--cyan-soft);line-height: 1;padding-top: 4px;font-variant-numeric: tabular-nums}\n  .faq-item h3 {font-size: 16.5px;color: var(--slate-900);margin-bottom: 8px}\n  .faq-item p {margin: 0;font-size: 14.5px;color: var(--slate-700);max-width: 52em}\n\n  /* ===== 页脚 ===== */\n  footer {background: var(--slate-900);color: var(--slate-300);padding: 48px 0 40px;font-size: 14px}\n  .foot-grid {display: grid;grid-template-columns: 1.4fr 1fr 1fr;gap: 32px}\n  footer .mark {margin-bottom: 12px;display: block}\n  footer p {color: var(--slate-500);margin: 0;max-width: 32em;font-size: 13.5px}\n  footer h4 {font-size: 12px;letter-spacing: .2em;text-transform: uppercase;color: var(--slate-300);margin: 0 0 12px;font-weight: 700}\n  footer li {margin-bottom: 8px;font-size: 13.5px}\n  footer a {color: var(--slate-300)}\n  footer a:hover {color: var(--cyan)}\n  .foot-bottom {margin-top: 36px;padding-top: 20px;border-top: 1px solid var(--slate-700);font-size: 12.5px;color: var(--slate-500);display: flex;flex-wrap: wrap;gap: 8px 24px;justify-content: space-between}\n\n  @media (max-width: 900px) {\n    .hero-grid {grid-template-columns: 1fr;gap: 32px}\n    .section-head {grid-template-columns: 1fr;gap: 10px}\n    .section-head p {grid-column: 1}\n    .plan-body {grid-template-columns: 1fr;gap: 16px}\n    .steps, .clients {grid-template-columns: 1fr}\n    .foot-grid {grid-template-columns: 1fr;gap: 28px}\n  }\n  @media (max-width: 560px) {\n    section {padding: 52px 0}\n    .hero {padding: 40px 0 48px}\n    .anchors {margin-bottom: 32px}\n    .hero-panel {padding: 22px 20px}\n    .plan {padding: 22px 20px}\n    .faq-block {padding: 4px 20px 8px}\n    .faq-item {grid-template-columns: 40px 1fr;gap: 12px}\n    .faq-num {font-size: 20px}\n  }\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <span class=\"mark\">雷神<span>云</span></span>\n    <span class=\"note\">订阅说明 · 使用指南 · 常见问题</span>\n  </div>\n</div>\n\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <nav class=\"anchors\" aria-label=\"页面导航\">\n      <a href=\"#plans\" class=\"is-active\">订阅方案</a>\n      <a href=\"#howto\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#about\">关于本站</a>\n    </nav>\n\n    <div class=\"hero-grid\">\n      <div>\n        <p class=\"kicker\">雷神云 · 服务说明页</p>\n        <h1>雷神云 · 把订阅这件事，<br><em>说清楚</em>再决定。</h1>\n        <p class=\"lede\">雷神云提供按月与按年两种计费方式的订阅方案，差异集中在三处：每月流量额度、同时在线设备数、可用线路类型。这一页把方案、步骤和常见问题一次列全，读完再选。</p>\n        <blockquote class=\"pullquote\">\n          <strong>先看一句</strong>\n          没有隐藏档位，也没有默认勾选。三档方案的权益都以文字列出，价格与年付折扣直接写在方案行里。\n        </blockquote>\n      </div>\n\n      <aside class=\"hero-panel\">\n        <h2>页面速览</h2>\n        <ul class=\"facts-list\">\n          <li><span class=\"k\">方案数量</span><span class=\"v\">3 档</span></li>\n          <li><span class=\"k\">计费方式</span><span class=\"v\">月付 / 年付</span></li>\n          <li><span class=\"k\">起订价格</span><span class=\"v\">¥15 / 月</span></li>\n          <li><span class=\"k\">年付优惠</span><span class=\"v\">约合十个月</span></li>\n          <li><span class=\"k\">设备上限</span><span class=\"v\">3 – 20 台</span></li>\n          <li><span class=\"k\">流量范围</span><span class=\"v\">100 – 1000GB</span></li>\n        </ul>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  \n  <section id=\"plans\" class=\"band-soft\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"label\">订阅方案</span>\n        <h2>三档方案，逐行看完再选</h2>\n        <p>每档方案单独成行：左边是定位与计费说明，右边是完整权益清单。年付价格按月付折算后的总额列出，不额外加收费用。</p>\n      </div>\n\n      <div class=\"plan-list\">\n\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name\">基础版</div>\n            <div>\n              <span class=\"price\">¥15<small>/ 月</small></span>\n              <span class=\"annual\">按年付仅需 ¥150 / 年</span>\n            </div>\n          </div>\n          <div class=\"plan-body\">\n            <p class=\"plan-note\">适合日常浏览、轻量流媒体播放的个人用户。流量额度有限，设备数也收紧到三台，够用但不宽裕。</p>\n            <ul class=\"plan-features\">\n              <li>每月 100GB 流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </div>\n        </article>\n\n        <article class=\"plan is-featured\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name\">旗舰版 <span class=\"tag\">推荐</span></div>\n            <div>\n              <span class=\"price\">¥35<small>/ 月</small></span>\n              <span class=\"annual\">按年付仅需 ¥350 / 年</span>\n            </div>\n          </div>\n          <div class=\"plan-body\">\n            <p class=\"plan-note\">流量与设备数都留了余量，同时把线路类型扩展到专线并加入优先工单支持。多数个人用户会停在这一档。</p>\n            <ul class=\"plan-features\">\n              <li>每月 300GB 流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n          </div>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name\">团队版</div>\n            <div>\n              <span class=\"price\">¥85<small>/ 月</small></span>\n              <span class=\"annual\">按年付仅需 ¥850 / 年</span>\n            </div>\n          </div>\n          <div class=\"plan-body\">\n            <p class=\"plan-note\">面向多人共用或集中管理的场景。设备数上限拉到二十台，并开放高带宽节点与路由定制，另配客户经理对接。</p>\n            <ul class=\"plan-features\">\n              <li>每月 1000GB 流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"howto\" class=\"band-white\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"label\">使用说明</span>\n        <h2>三步走完，从选择到连上</h2>\n        <p>流程不复杂，难的是把每一步判断清楚。下面按顺序写，做完一步再进下一步。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"num\">STEP 01</div>\n          <h3>先估自己的用量</h3>\n          <p>翻一下近一个月的实际使用：看视频多还是查资料多，一台设备还是几台换着用。流量与设备数是选方案的唯一分水岭，估准这两项，方案就定了。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">STEP 02</div>\n          <h3>再定计费周期</h3>\n          <p>月付适合先试一段、随时调整的人；年付总价相当于十个月，适合确定长期使用的人。切换周期不改变该档方案包含的权益内容。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">STEP 03</div>\n          <h3>最后配到客户端</h3>\n          <p>按你手上的系统挑对应客户端，把订阅信息填入客户端的订阅栏，保存后手动更新一次即可生效。改动设备或系统时重复这一步。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"clients\" class=\"band-soft\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"label\">客户端</span>\n        <h2>按系统选工具，不追求统一</h2>\n        <p>不同系统的客户端各有更新节奏与操作差异。这里只列出常见搭配与选择思路，具体下载请以各项目官方发布页为准。</p>\n      </div>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <div class=\"platform\">Windows</div>\n          <h3>桌面端场景</h3>\n          <p>适合长期开着的办公机。优先选支持托盘常驻、能一键切换配置文件的客户端，更新订阅后不必反复重启。</p>\n          <a class=\"link muted\" href=\"#\">下载地址以官方发布页为准</a>\n        </article>\n        <article class=\"client\">\n          <div class=\"platform\">macOS</div>\n          <h3>桌面端场景</h3>\n          <p>适合与手机、平板混用的用户。安装时留意系统对网络扩展的授权提示，首次运行需要在系统设置里放行。</p>\n          <a class=\"link muted\" href=\"#\">下载地址以官方发布页为准</a>\n        </article>\n        <article class=\"client\">\n          <div class=\"platform\">Android</div>\n          <h3>移动端场景</h3>\n          <p>机型与系统版本差异较大，安装包来源要看清。部分系统会限制后台运行，需在电池设置里单独放行。</p>\n          <a class=\"link muted\" href=\"#\">下载地址以官方发布页为准</a>\n        </article>\n        <article class=\"client\">\n          <div class=\"platform\">iOS / iPadOS</div>\n          <h3>移动端场景</h3>\n          <p>只能通过 App Store 安装，需注意所用 Apple ID 的地区。配置以导入订阅链接为主，手动录入较少。</p>\n          <a class=\"link muted\" href=\"#\">下载地址以官方发布页为准</a>\n        </article>\n        <article class=\"client\">\n          <div class=\"platform\">Linux</div>\n          <h3>命令行场景</h3>\n          <p>适合服务器或常驻终端。配置文件通常放在用户目录下，修改后重载服务即可，不需要图形界面。</p>\n          <a class=\"link muted\" href=\"#\">下载地址以官方发布页为准</a>\n        </article>\n        <article class=\"client\">\n          <div class=\"platform\">Router</div>\n          <h3>整网场景</h3>\n          <p>适合设备多、不想逐台配置的用户。路由器性能与固件差异会影响效果，配置前先确认型号与固件是否支持。</p>\n          <a class=\"link muted\" href=\"#\">下载地址以官方发布页为准</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"faq\" class=\"band-white\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"label\">常见问题</span>\n        <h2>八个问题，按顺序回答</h2>\n        <p>问题按用户实际会遇到的先后排列，从选方案、付款，到配置和多设备使用。答案尽量给判断依据，而不是一句“可以”。</p>\n      </div>\n\n      <div class=\"faq-block\">\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">01</div>\n          <div>\n            <h3>三档方案的差别到底在哪？</h3>\n            <p>三处：每月流量额度（100GB / 300GB / 1000GB）、同时在线设备数（3 / 5 / 20 台）、线路类型。旗舰版与团队版还分别增加了优先工单与专线、高带宽节点和客户经理服务，基础版不包含这些。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">02</div>\n          <div>\n            <h3>年付比月付省多少？</h3>\n            <p>按页面标价，三档年付总额分别是 ¥150、¥350、¥850，折合每月等于十个月的价钱，即省下两个月。年付不影响方案本身的权益内容，只是计费周期不同。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">03</div>\n          <div>\n            <h3>用超了流量会怎样？</h3>\n            <p>页面只标明了各档每月流量额度，未标注超额后的处理方式。下单前请先以服务方的正式条款为准，避免用到月中才发现规则不同。如果预估用量接近上限，直接选上一档更稳妥。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">04</div>\n          <div>\n            <h3>“同时在线”怎么算？</h3>\n            <p>指在同一时间保持连接的设备数量，不是累计登录过的设备数量。基础版 3 台、旗舰版 5 台、团队版 20 台。家中手机、电脑、平板同时开着，就要一起计入。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">05</div>\n          <div>\n            <h3>换设备需要重新购买吗？</h3>\n            <p>不需要，同一方案下更换设备只是改配置。停用旧设备、在新设备上导入订阅即可，注意不要超过所在档位的并发上限。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">06</div>\n          <div>\n            <h3>客户端该选哪一个？</h3>\n            <p>看系统定，不看推荐榜。桌面端优先选支持托盘常驻与配置文件切换的客户端；移动端受应用商店地区限制，安装前先确认账号可用；路由器方案要先核对型号与固件是否支持。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">07</div>\n          <div>\n            <h3>团队版适合什么规模的团队？</h3>\n            <p>从设备数上限看，二十台以内的共用需求落在团队版区间内。若还需要路由定制与固定对接人，这一档也是唯一提供对应权益的方案。</p>\n          </div>\n        </div>\n\n        <div class=\"faq-item\">\n          <div class=\"faq-num\">08</div>\n          <div>\n            <h3>这份页面上的信息是官方承诺吗？</h3>\n            <p>不是。本页是雷神云的方案与使用说明整理，价格与权益均按页面所列内容呈现，未涉及服务性能、节点数量、兼容性等未提供的信息。正式条款以下单时服务方展示的内容为准。</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"about\" class=\"band-soft\">\n    <div class=\"wrap\">\n      <div class=\"section-head\">\n        <span class=\"label\">关于本站</span>\n        <h2>这一页写了什么，没写什么</h2>\n        <p>写的是：三档方案的价格与权益、从选择到配置的步骤、按系统划分的客户端思路，以及八条常见问题的判断依据。没写的是：速度表现、节点分布、用户评价与退款规则——这些没有可靠依据的部分不在此页呈现。</p>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <span class=\"mark\">雷神<span>云</span></span>\n        <p>方案、步骤与常见问题的整理页。价格与权益以正文所列内容为准，正式条款以下单时服务方展示的信息为准。</p>\n      </div>\n      <div>\n        <h4>本页目录</h4>\n        <ul>\n          <li><a href=\"#plans\">订阅方案</a></li>\n          <li><a href=\"#howto\">使用说明</a></li>\n          <li><a href=\"#clients\">客户端</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>方案速记</h4>\n        <ul>\n          <li>基础版 ¥15/月 · 年付 ¥150</li>\n          <li>旗舰版 ¥35/月 · 年付 ¥350</li>\n          <li>团队版 ¥85/月 · 年付 ¥850</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"foot-bottom\">\n      <span>雷神云 · 服务说明页</span>\n      <span>页面内容不含性能承诺与交易链接</span>\n    </div>\n  </div>\n</footer>",
